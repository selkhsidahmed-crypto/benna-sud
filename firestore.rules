rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // الجميع يقرأ (الزبائن)، والمالك فقط يكتب.
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'selkhsidahmed@gmail.com';
    }
  }
}
